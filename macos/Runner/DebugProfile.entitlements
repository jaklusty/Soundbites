<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox is off: the app spawns yt-dlp and ffmpeg and reads whatever folder the
	     user chooses as the library. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- An ad-hoc signature has no Team ID; without this the app cannot load its own frameworks
	     once the hardened runtime is on. Harmless until then; remove with Developer ID signing. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
