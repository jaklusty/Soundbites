<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Needed by Electron/V8 in all builds. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- An ad-hoc signature has no Team ID, so library validation must be off or the app cannot
       load the Electron framework. Harmless while hardenedRuntime is false; required once it is
       true and the identity is still "-". Remove when a Developer ID identity is used. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
